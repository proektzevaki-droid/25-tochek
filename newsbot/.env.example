# Данные приложения Telegram — берутся на https://my.telegram.org → API development tools
# Нужны для чтения каналов от имени вашего аккаунта (юзербот).
TG_API_ID=1234567
TG_API_HASH=0123456789abcdef0123456789abcdef

# Токен бота от @BotFather — им бот присылает вам отфильтрованные новости.
BOT_TOKEN=1234567890:AAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Необязательно: пароль двухфакторки аккаунта, если включена (иначе спросит при логине).
# TG_PASSWORD=
